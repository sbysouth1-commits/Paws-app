# Supabase credentials. Copy this file to ".env" and fill in your values.
# Find them in the Supabase dashboard: Project Settings → API.
# The EXPO_PUBLIC_ prefix is required so Expo exposes them to the app.
# The anon key is safe to ship in a client app — row-level security (see
# supabase/schema.sql) is what protects the data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
